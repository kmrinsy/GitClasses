#!/bin/bash

# Function to perform calculations
calculate() {
    local numa1=$1
    local numa2=$2
    local operator=$3

    case $operator in
        +)
            result=$((num1 + num2))
            ;;
        -)
            result=$((num1 - num2))
            ;;
        \*)
            result=$((num1 * num2))
            ;;
        /)
            if [ $num2 -ne 0 ]; then
                result=$((num1 / num2))
            else
                echo "Error: Division by zero."
                exit 1
            fi
            ;;
        %)
            result=$((num1 % num2))
            ;;
        *)
            echo "Error: Unsupported operator."
            exit 1
            ;;
    esac

    echo "Result: $result"
    echo "This is Rinsy"
}

# Main script
read -p "Enter first number: " num1
read -p "Enter second number: " num2
read -p "Enter operator (+, -, *, /, %): " operator

calculate $num1 $num2 $operator

